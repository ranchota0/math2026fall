# Keep source and review artifacts tracked by default:
# dist/tex/
# reports/
# config/
# templates/
# lessons/
# references/README.md
# references/source_info.md

# Official textbook binaries are reproducible downloads and must not enter version control.
# Keep the adjacent metadata JSON and download reports tracked.
references/textbooks/**/*.pdf
/references/textbook.pdf
/义务教育教科书*.pdf

# Local browser/download state and sensitive authentication artifacts.
temp/
browser-profile/
downloads/
logs/*sensitive*
*.cookie
*.token

# Historical safety copies are local-only and duplicate the tracked deliverables.
backup/
